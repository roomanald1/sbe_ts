{
  "": "../../node_modules/nx/schemas/project-schema.json",
  "name": "homepage",
  "projectType": "application",
  "sourceRoot": "apps/homepage/src",
  "targets": {
    "build": { "executor": "nx:run-commands", "cache": true, "outputs": ["{projectRoot}/dist"], "options": { "cwd": "apps/homepage", "command": "npm run build" } },
    "serve": { "executor": "nx:run-commands", "continuous": true, "options": { "cwd": "apps/homepage", "command": "npm run dev" } },
    "lint": { "executor": "nx:run-commands", "cache": true, "options": { "cwd": "apps/homepage", "command": "npm run lint" } },
    "preview": { "executor": "nx:run-commands", "continuous": true, "options": { "cwd": "apps/homepage", "command": "npm run preview" } },
    "typecheck": { "executor": "nx:run-commands", "cache": true, "options": { "cwd": "apps/homepage", "command": "tsc -b --pretty false" } }
  }
}
