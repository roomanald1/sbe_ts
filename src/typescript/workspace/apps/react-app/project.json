{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "react-app",
  "projectType": "application",
  "sourceRoot": "apps/react-app/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/react-app",
        "command": "npm run build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/react-app",
        "command": "npm run dev"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/react-app",
        "command": "npm run lint"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/react-app",
        "command": "npm run preview"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/react-app",
        "command": "tsc -b --pretty false"
      }
    }
  }
}
