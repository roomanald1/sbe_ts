FROM rust:1.88-bookworm AS build
ARG CRATE
ARG BIN
ARG FEATURES=
WORKDIR /workspace
COPY src/rust ./src/rust
RUN if [ -n "${FEATURES}" ]; then cargo build --release --manifest-path "src/rust/${CRATE}/Cargo.toml" --bin "${BIN}" --features "${FEATURES}"; else cargo build --release --manifest-path "src/rust/${CRATE}/Cargo.toml" --bin "${BIN}"; fi

FROM debian:bookworm-slim
ARG CRATE
ARG BIN
ARG FEATURES=
COPY --from=build /usr/bin/bash /usr/bin/bash
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /lib/x86_64-linux-gnu/libssl.so.3 /lib/x86_64-linux-gnu/libssl.so.3
COPY --from=build /lib/x86_64-linux-gnu/libcrypto.so.3 /lib/x86_64-linux-gnu/libcrypto.so.3
COPY --from=build /workspace/src/rust/${CRATE}/target/release/${BIN} /usr/local/bin/service
ENTRYPOINT ["/usr/local/bin/service"]
