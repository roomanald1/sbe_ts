FROM node:22-alpine
WORKDIR /app
COPY src/typescript/workspace/package*.json ./
COPY src/typescript/workspace/apps/react-app/package.json ./apps/react-app/package.json
RUN npm ci
COPY src/typescript/workspace ./
WORKDIR /app/apps/react-app
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
