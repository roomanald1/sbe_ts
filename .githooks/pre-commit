#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
prettier="$repo_root/src/typescript/workspace/node_modules/.bin/prettier"

if [[ ! -x "$prettier" ]]; then
  printf 'Prettier is not installed at %s\n' "$prettier" >&2
  printf 'Install the TypeScript workspace dependencies before committing TypeScript changes.\n' >&2
  exit 1
fi

staged_files="$(mktemp)"
trap 'rm -f "$staged_files"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR -- '*.ts' '*.tsx' > "$staged_files"

while IFS= read -r -d '' file; do
  # Do not accidentally stage unrelated unstaged edits when formatting a staged file.
  if ! git diff --quiet -- "$file"; then
    printf 'Cannot auto-format %s because it also has unstaged changes. Stage or separate those edits first.\n' "$file" >&2
    exit 1
  fi

  "$prettier" --write "$repo_root/$file"
  git add -- "$file"
done < "$staged_files"
